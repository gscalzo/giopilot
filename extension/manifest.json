{
  "manifest_version": 3,
  "name": "Slop Radar",
  "version": "0.1.0",
  "description": "Flags AI-patterned writing in your LinkedIn feed, with model-backed analysis. A radar, not an authorship oracle.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/feed*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
